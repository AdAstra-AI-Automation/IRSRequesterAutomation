# Copy to `.env` on the server for real production credentials and URLs.
# If `.env` is missing, docker-compose still injects non-empty defaults (same as src/qa_irs_pin/config.py) so the token URL is never relative.

# Live Connect endpoints
CONNECT_AUTH_BASE=https://appbe.ad-astrainc.com
CONNECT_API_BASE=https://appbe.ad-astrainc.com
CONNECT_SEARCH_BASE=https://appbe.ad-astrainc.com

# Live Connect credentials
CONNECT_EMAIL=your-live-connect-email@ad-astrainc.com
CONNECT_PASSWORD=your-live-connect-password

# Production behavior
DEFAULT_PRECALL_POLICY=
REQUEST_TIMEOUT_SECONDS=30
SITE_MATCH_THRESHOLD=80

# Optional internal Dev Use access
DEV_USE_USERNAME=
DEV_USE_PASSWORD=

# Microsoft Graph (for SharePoint site/state lookup)
GRAPH_TENANT=adastrainccom.onmicrosoft.com
GRAPH_CLIENT_ID=d3590ed6-52b3-4102-aeff-aad2292ab01c
GRAPH_USERNAME=Teams@ad-astrainc.com
GRAPH_PASSWORD=your-graph-password
# Append new IRS sites after successful Connect creation (requires delegated Files.ReadWrite).
GRAPH_MASTER_SHEET_SYNC=true
